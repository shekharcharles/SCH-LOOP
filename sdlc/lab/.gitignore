.sch-loop/private/
.sch-loop/evidence/
.sch-loop/council/*/transcript/
.sch-loop/heartbeat
.sch-loop/events.jsonl
.worktrees/
node_modules/
.env
.env.*
*.log

# Engine snapshot: a working copy of ../engine/. Not committed — ../engine/ is the
# tracked source of truth and a second copy in git would drift. Refresh with
#   cp -r ../engine/runtime ../engine/scripts .claude/sch/
# and never the other way: edits made here are invisible to git.
.claude/sch/

# Engine run state and the lessons log: regenerated on every run.
.sch-loop/runs/
.sch-loop/learning/
.sch-loop/workflow.json

# Other agents' scratch state that lands in a project directory.
.omo/
.codegraph/
