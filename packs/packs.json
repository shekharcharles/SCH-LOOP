{
  "_comment": "Per-domain pack config. The engine (sch-spec/plan/run/ship) reads the project's domain and follows the matching entry. dispatch = installed skills to USE, never reinvent. scope_required + active_gating drive the offensive authorization guard. method = the phase methodology body to follow.",
  "app-dev": {
    "kind": "dev",
    "spec": "PRD.md",
    "unit": "feature task (1 day or less)",
    "dispatch": [
      "taste-skill",
      "impeccable",
      "redesign-skill",
      "design-dna",
      "frontend-ui-engineering",
      "nextjs-app-router-patterns",
      "react-state-management",
      "tailwindcss",
      "design-system-patterns",
      "responsive-design",
      "motion-design",
      "gsap-scrolltrigger",
      "gsap-react",
      "threejs-fundamentals",
      "dataviz",
      "accessibility-compliance",
      "react-native-architecture",
      "output-skill",
      "fastapi-templates",
      "nodejs-backend-patterns"
    ],
    "dispatch_guide": "packs/app-dev.md — which-skill-when table",
    "validate": "playwright",
    "complete": "git-merge",
    "deliver": "deploy",
    "concurrency": "parallel",
    "scope_required": false,
    "active_gating": false
  },
  "tool-dev": {
    "kind": "dev",
    "spec": "PRD.md",
    "unit": "feature task (1 day or less)",
    "dispatch": [
      "python-project-structure",
      "python-packaging",
      "python-testing-patterns",
      "rust-async-patterns",
      "modern-python",
      "bash-defensive-patterns",
      "gh-cli"
    ],
    "validate": "run-the-tool",
    "complete": "git-merge",
    "deliver": "package-and-publish",
    "concurrency": "parallel",
    "scope_required": false,
    "active_gating": false
  }
}
